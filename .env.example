ANTHROPIC_API_KEY=""
# CLAUDE_MODEL=claude-sonnet-5-5

# Optional: require `Authorization: Bearer <token>` on /ask (recommended when serving on 0.0.0.0).
# API_TOKEN=

# Optional: where `python api.py` listens (defaults shown).
# API_HOST=0.0.0.0
# API_PORT=8000

# Optional: print each /ask question, answer, sources and response JSON (default true).
# DEBUG_LOG=false

# Optional: only used when ANTHROPIC_API_KEY is not set, as a free local fallback.
# Requires Ollama (https://ollama.com) installed and running, with the model pulled
# (e.g. `ollama pull qwen2.5:1.5b`).
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:1.5b
